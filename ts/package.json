{
  "name": "@shelbeely/google-takeout-parser",
  "version": "0.1.0",
  "description": "Parse a Google Takeout into events consumable by AI agents (OpenClaw / OpenViking).",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/models/index.ts",
    "./parsers": "./src/parsers/index.ts",
    "./exporters": "./src/exporters/index.ts"
  },
  "bin": {
    "google-takeout-parser": "./src/cli/bin.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "test": "bun test",
    "build": "bun build ./src/cli/bin.ts --target=bun --outfile=./dist/google-takeout-parser.js",
    "build:binary": "bun build ./src/cli/bin.ts --compile --outfile=./dist/google-takeout-parser",
    "start": "bun run ./src/cli/bin.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "google",
    "takeout",
    "parser",
    "openclaw",
    "openviking",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.10",
    "typescript": "^5.6.3"
  }
}
